<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- SDK zkemkeeper cua ZKTeco chi co ban 32-bit nen tool phai chay x86 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Goi COM zkemkeeper kieu late-binding qua ProgID, khong can interop assembly luc build -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <RootNamespace>ZkPullerPF</RootNamespace>
    <AssemblyName>ZkPullerPF</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
