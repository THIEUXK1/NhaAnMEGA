@{
    // Layout riêng cho các màn hình quản lý (Báo cáo, Black list, Khách ăn, Check suất ăn, Quên thẻ)
    var duongDan = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();
    Func<string, string> cssMuc = href =>
        duongDan.StartsWith(href.ToLowerInvariant()) ? "qs-menu-item active" : "qs-menu-item";
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>@ViewData["Title"] - Hệ thống Nhà Ăn</title>

    <link rel="icon" type="image/png" href="https://img.icons8.com/?size=100&id=9RltCaVrpXLu&format=png&color=000000">

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/quanly.css" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- Thanh trên cùng: chỉ hiện ở màn hình hẹp -->
    <header class="qs-topbar">
        <button type="button" class="qs-topbar-nut" id="qsMoMenu" aria-label="Mở menu">
            <i class="fa-solid fa-bars"></i>
        </button>
        <span class="qs-topbar-ten"><i class="fa-solid fa-utensils"></i> Nhà ăn MEGA</span>
    </header>

    <div class="qs-lop-phu" id="qsLopPhu"></div>

    <nav class="qs-menu" id="qsMenu">
        <div class="qs-menu-brand">
            <span class="qs-menu-logo"><i class="fa-solid fa-utensils"></i></span>
            <span class="qs-menu-brand-chu">
                <b>Nhà ăn MEGA</b>
                <small>Quản lý suất ăn</small>
            </span>
            <button type="button" class="qs-menu-thu" id="qsThuMenu" aria-label="Thu gọn menu">
                <i class="fa-solid fa-angles-left"></i>
            </button>
        </div>

        <div class="qs-menu-cuon">
            <div class="qs-menu-nhom">Tổng quan</div>
            <a class="@cssMuc("/MG/An/BaoCaoNgay")" href="/MG/An/BaoCaoNgay" title="Báo cáo hằng ngày">
                <i class="fa-solid fa-chart-column"></i><span>Báo cáo hằng ngày</span>
            </a>

            <div class="qs-menu-nhom">Quản lý</div>
            <a class="@cssMuc("/MG/BlackList")" href="/MG/BlackList" title="Black list">
                <i class="fa-solid fa-user-lock"></i><span>Black list</span>
            </a>
            <a class="@cssMuc("/MG/KhachAn")" href="/MG/KhachAn" title="Khách ăn">
                <i class="fa-solid fa-user-group"></i><span>Khách ăn</span>
            </a>

            <div class="qs-menu-nhom">Kiểm tra</div>
            <a class="@cssMuc("/MG/An/CheckAnh")" href="/MG/An/CheckAnh" title="Check suất ăn">
                <i class="fa-solid fa-image"></i><span>Check suất ăn</span>
            </a>
            <a class="@cssMuc("/MG/An/QuenThe")" href="/MG/An/QuenThe" title="Check quên thẻ">
                <i class="fa-solid fa-id-card"></i><span>Check quên thẻ</span>
            </a>
        </div>

        <a class="qs-menu-item qs-menu-back" href="/MG/An" title="Màn hình quét">
            <i class="fa-solid fa-arrow-left"></i><span>Màn hình quét</span>
        </a>
    </nav>

    <main role="main" class="qs-main">
        @RenderBody()
    </main>

    <div class="qs-toast-boc" id="qsToast"></div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/quanly-chung.js" asp-append-version="true"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
